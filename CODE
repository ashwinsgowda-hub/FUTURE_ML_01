import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from prophet import Prophet


local_csv = "superstore_sales.csv"
url = "https://raw.githubusercontent.com/bernardkilonzo-rigor/dataviz/main/data/Sample%20-%20Superstore.csv"

df = None
if os.path.exists(local_csv):
    print(f"Loading local dataset: '{local_csv}'...")
    df = pd.read_csv(local_csv, encoding="latin1")
else:
    try:
        print("Downloading Superstore dataset from repository...")
        df = pd.read_csv(url, encoding="latin1")
        print("Dataset loaded successfully!")
    except Exception as e:
        print(f"Error loading file: {e}. Exiting.")
        exit()

# Detect columns
date_col = [c for c in df.columns if 'date' in c.lower()][0]
sales_col = [c for c in df.columns if 'sales' in c.lower()][0]
category_col = [c for c in df.columns if 'category' in c.lower()][0]

df[date_col] = pd.to_datetime(df[date_col], dayfirst=True, format='mixed')

df_weekly = df.set_index(date_col)[sales_col].resample('W').sum().reset_index()
df_weekly = df_weekly.rename(columns={date_col: 'ds', sales_col: 'y'}).sort_values('ds').reset_index(drop=True)

TEST_WEEKS = 12
train_df = df_weekly.iloc[:-TEST_WEEKS]
test_df = df_weekly.iloc[-TEST_WEEKS:]

# Evaluation Model
eval_model = Prophet(yearly_seasonality=True, weekly_seasonality=False)
eval_model.fit(train_df[['ds', 'y']])

future_eval = eval_model.make_future_dataframe(periods=TEST_WEEKS, freq='W')
forecast_eval = eval_model.predict(future_eval)

y_true = test_df['y'].values
y_pred = forecast_eval['yhat'].tail(TEST_WEEKS).values

# Fast numpy metrics (Replacing scikit-learn)
mae = np.mean(np.abs(y_true - y_pred))
mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100

# Production Model (Full Forecast)
prod_model = Prophet(yearly_seasonality=True, weekly_seasonality=False)
prod_model.fit(df_weekly[['ds', 'y']])
future_12w = prod_model.make_future_dataframe(periods=12, freq='W')
forecast_12w = prod_model.predict(future_12w)


categories = df[category_col].unique()
recommendations = []

for cat in categories:
    cat_df = df[df[category_col] == cat].copy()
    cat_df = cat_df.set_index(date_col)[sales_col].resample('W').sum().reset_index()
    cat_df = cat_df.rename(columns={date_col: 'ds', sales_col: 'y'}).sort_values('ds').reset_index(drop=True)
    
    if len(cat_df) > 12:
        model = Prophet(yearly_seasonality=True, weekly_seasonality=False)
        model.fit(cat_df[['ds', 'y']])
        future = model.make_future_dataframe(periods=12, freq='W')
        fcst = model.predict(future)
        
        predicted_sales = fcst['yhat'].tail(12).sum()
        past_sales = cat_df['y'].tail(12).sum()
        growth = ((predicted_sales - past_sales) / past_sales) * 100
        
        recommendations.append({
            'category': cat,
            'growth': growth,
            'forecast': predicted_sales
        })

# Sort categories by projected growth
recommendations = sorted(recommendations, key=lambda x: x['growth'], reverse=True)


fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 9))

# Plot 1: Main 12-Week Forecast
ax1.plot(df_weekly['ds'], df_weekly['y'], label="Historical Weekly Sales", color="#1f77b4", alpha=0.7)
ax1.plot(forecast_12w['ds'].tail(12), forecast_12w['yhat'].tail(12), label="12-Week Refined Forecast", color="#ff7f0e", linewidth=2.5)
ax1.fill_between(
    forecast_12w['ds'].tail(12),
    forecast_12w['yhat_lower'].tail(12),
    forecast_12w['yhat_upper'].tail(12),
    color='#ff7f0e', alpha=0.15, label="Confidence Interval"
)
ax1.set_title("Superstore Sales - Historical Performance & 12-Week Weekly Forecast", fontsize=13, fontweight='bold')
ax1.set_ylabel("Weekly Sales ($)")
ax1.legend(loc="upper left")
ax1.grid(True, linestyle="--", alpha=0.5)

# Plot 2: Test Validation
ax2.plot(test_df['ds'], y_true, label="Actual Sales (Test Period)", color="black", linewidth=1.5)
ax2.plot(test_df['ds'], y_pred, label="Predicted Sales", color="red", linestyle="--", linewidth=2)
ax2.set_title(f"Model Validation (Last {TEST_WEEKS} Weeks) - MAE: ${mae:.2f} | MAPE: {mape:.2f}%", fontsize=11)
ax2.set_ylabel("Weekly Sales ($)")
ax2.legend(loc="upper left")
ax2.grid(True, linestyle="--", alpha=0.5)

plt.tight_layout()
plt.show()


print("\n" + "="*65)
print("             EXECUTIVE BUSINESS BRIEFING & RECOMMENDATIONS")
print("="*65)
print(f"• Overall Validation Error (MAE) : ${mae:.2f} per week")
print(f"• Mean Absolute Percent Error   : {mape:.2f}%")
print("-" * 65)
print("CATEGORY GROWTH FORECAST (NEXT 12 WEEKS):")

for i, rec in enumerate(recommendations):
    print(f" {i+1}. {rec['category']:<20} | Projected Growth: {rec['growth']:>+6.1f}% | Sales: ${rec['forecast']:,.2f}")

print("-" * 65)
print("FUTURE BUSINESS RECOMMENDATIONS:")
top_cat = recommendations[0]
low_cat = recommendations[-1]

print(f"1. INVENTORY PRIORITIZATION: Direct additional purchasing capital toward '{top_cat['category']}'")
print(f"   due to a projected growth trend of {top_cat['growth']:+.1f}% over the coming quarter.")

if low_cat['growth'] < 0:
    print(f"2. STOCK & PROMOTIONS: Apply targeted discounts to '{low_cat['category']}'")
    print(f"   (projected decline of {low_cat['growth']:.1f}%) to prevent overstocking and free up cash flow.")
else:
    print(f"2. STOCK MAINTENANCE: Maintain current inventory levels for '{low_cat['category']}'.")

print("3. STAFFING & CASH FLOW: Align store staffing schedule with weekly sales cycles")
print(f"   to handle the expected quarterly revenue of ${forecast_12w['yhat'].tail(12).sum():,.2f}.")
print("="*65)
